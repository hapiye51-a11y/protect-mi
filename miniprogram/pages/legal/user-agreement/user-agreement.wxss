.container {
  min-height: 100vh;
  background: #fff;
}

.header {
  padding: 40rpx 30rpx;
  background: linear-gradient(135deg, #4CAF50, #66BB6A);
  color: #fff;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.update-time, .effective-time {
  display: block;
  font-size: 24rpx;
  opacity: 0.9;
  margin-bottom: 4rpx;
}

.content {
  padding: 30rpx;
}

.section {
  margin-bottom: 40rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.section-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.8;
  color: #555;
  margin-bottom: 16rpx;
}

.list-item {
  display: flex;
  margin-bottom: 12rpx;
}

.list-dot {
  font-size: 28rpx;
  color: #4CAF50;
  margin-right: 12rpx;
}

.list-text {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.6;
  color: #555;
}

.contact-info {
  background: #E8F5E9;
  padding: 20rpx;
  border-radius: 12rpx;
  margin: 16rpx 0;
}

.contact-item {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.contact-item:last-child {
  margin-bottom: 0;
}

.bottom-space {
  height: 60rpx;
}
