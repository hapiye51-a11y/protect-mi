.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.form-section {
  padding: 20rpx;
}

.form-group {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

/* 标题输入 */
.title-input {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  width: 100%;
}

/* 内容输入 */
.content-input {
  width: 100%;
  min-height: 300rpx;
  font-size: 30rpx;
  line-height: 1.8;
  color: #333;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
}

/* 图片上传 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 0;
  right: 0;
  width: 48rpx;
  height: 48rpx;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 0 0 16rpx;
}

.delete-icon {
  color: #fff;
  font-size: 32rpx;
}

.image-item.add-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #ddd;
  background: #f9f9f9;
}

.add-icon {
  font-size: 48rpx;
  color: #ccc;
}

.add-text {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 标签选择 */
.group-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.tag-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-option {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  border-radius: 30rpx;
  background: #f5f5f5;
  border: 2rpx solid transparent;
}

.tag-option.selected {
  background: #E0F7FA;
  border-color: #00BCD4;
}

.tag-emoji {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.tag-name {
  font-size: 26rpx;
  color: #666;
}

.tag-option.selected .tag-name {
  color: #00838F;
}

/* 心情选择 */
.mood-options {
  display: flex;
  justify-content: space-around;
}

.mood-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
}

.mood-option.selected {
  background: #f0f0f0;
  border-radius: 16rpx;
}

.mood-emoji {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.mood-name {
  font-size: 24rpx;
  color: #666;
}

.mood-option.selected .mood-name {
  color: #00BCD4;
}

/* 发布按钮 */
.save-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.08);
}

.save-btn {
  width: 100%;
  height: 88rpx;
  background: #00BCD4;
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  border: none;
}
