/* 登录页 - 温暖自然风格 */
page {
  height: 100vh;
  background: linear-gradient(135deg, #F8F9FA 0%, #E8F5E9 50%, #F8F9FA 100%);
  overflow: hidden;
}

/* 隐藏导航栏返回按钮 */
::-webkit-scrollbar {
  display: none;
}

.container {
  width: 100%;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

/* 背景装饰 */
.bg-decoration {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  overflow: hidden;
}

.circle {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(76, 175, 80, 0.1) 0%, transparent 70%);
  animation: float 20s infinite ease-in-out;
}

.circle-1 {
  width: 400rpx;
  height: 400rpx;
  top: -100rpx;
  right: -100rpx;
  animation-delay: 0s;
}

.circle-2 {
  width: 300rpx;
  height: 300rpx;
  bottom: 100rpx;
  left: -80rpx;
  animation-delay: 7s;
}

.circle-3 {
  width: 200rpx;
  height: 200rpx;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  animation-delay: 14s;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0) scale(1);
    opacity: 0.3;
  }
  50% {
    transform: translateY(-30rpx) scale(1.1);
    opacity: 0.6;
  }
}

/* 主要内容 */
.content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 80rpx 32rpx 120rpx;
  position: relative;
  z-index: 1;
}

/* Logo 区域 - 千人千面猫咪拍立得 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 120rpx;
  animation: fadeInDown 1s ease;
}

@keyframes fadeInDown {
  from {
    opacity: 0;
    transform: translateY(-50rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 拍立得卡片 */
.cat-polaroid {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #FFFFFF;
  padding: 24rpx 24rpx 32rpx;
  border-radius: 16rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
  margin-bottom: 32rpx;
  animation: pulse 3s infinite ease-in-out;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1) rotate(0deg);
  }
  50% {
    transform: scale(1.02) rotate(1deg);
  }
}

/* 猫咪图片方框 - 艺术画框风格 */
.cat-frame {
  position: relative;
  width: 400rpx;
  height: 400rpx;
  border: 4rpx solid #FF9800;
  background: linear-gradient(135deg, #FFF8E1 0%, #FFECB3 100%);
  box-shadow: 8rpx 8rpx 0rpx #FF9500;
  margin-bottom: 24rpx;
  overflow: hidden;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cat-frame:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 6rpx 6rpx 0rpx #FF9500;
}

/* Emoji 模式 */
.cat-emoji-mode {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  animation: catFloat 3s infinite ease-in-out;
}

@keyframes catFloat {
  0%, 100% {
    transform: translateY(0) rotate(0deg);
  }
  25% {
    transform: translateY(-10rpx) rotate(-2deg);
  }
  75% {
    transform: translateY(-5rpx) rotate(2deg);
  }
}

.big-emoji {
  font-size: 200rpx;
  line-height: 1;
  z-index: 1;
  filter: drop-shadow(0 8rpx 16rpx rgba(0, 0, 0, 0.15));
}

.emoji-bg {
  position: absolute;
  width: 280rpx;
  height: 280rpx;
  background: radial-gradient(circle, rgba(255, 152, 0, 0.15) 0%, transparent 70%);
  border-radius: 50%;
}

/* 品牌猫爪标识 - 右下角半透明 */
.paw-mark {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  font-size: 48rpx;
  opacity: 0.3;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.2));
  animation: pawPulse 2s infinite ease-in-out;
}

@keyframes pawPulse {
  0%, 100% {
    transform: scale(1);
    opacity: 0.3;
  }
  50% {
    transform: scale(1.1);
    opacity: 0.5;
  }
}

/* Logo 文字 */
.logo-text {
  font-size: 48rpx;
  font-weight: 700;
  color: #333333;
  letter-spacing: 3rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

.logo-slogan {
  font-size: 28rpx;
  color: #B45309;
  letter-spacing: 1rpx;
  opacity: 0.9;
}

/* 登录按钮区域 */
.login-section {
  width: 100%;
  padding: 0 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  animation: fadeInUp 1s ease;
  animation-delay: 0.3s;
  animation-fill-mode: backwards;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(50rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 登录按钮 */
.login-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #4CAF50 0%, #81C784 100%);
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(76, 175, 80, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  transition: all 0.3s ease;
}

.login-btn.disabled {
  opacity: 0.6;
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.2);
}

.login-btn-hover {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.3);
}

.btn-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.wechat-icon {
  font-size: 48rpx;
  line-height: 48rpx;
}

.btn-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 1rpx;
}

/* 协议勾选行 */
.agreement-row {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  width: 100%;
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #ddd;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.checkbox.checked {
  background: #4CAF50;
  border-color: #4CAF50;
}

.check-icon {
  color: #fff;
  font-size: 22rpx;
  font-weight: bold;
}

.agreement-text-wrap {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: nowrap;
}

.agreement-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.link {
  font-size: 24rpx;
  color: #4CAF50;
  font-weight: 500;
}

/* 跳过按钮 */
.skip-btn {
  padding: 16rpx 32rpx;
  transition: all 0.3s ease;
}

.skip-btn:active {
  transform: scale(0.95);
}

.skip-text {
  font-size: 26rpx;
  color: #4CAF50;
  letter-spacing: 0.5rpx;
}

/* 跳过登录 */
.skip-row {
  padding: 20rpx 0;
  text-align: center;
}

.skip-text {
  font-size: 26rpx;
  color: #999;
}

/* 底部信息 */
.footer {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  z-index: 1;
}

.footer-cats {
  display: flex;
  gap: 32rpx;
  animation: bounce 2s infinite ease-in-out;
}

@keyframes bounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10rpx);
  }
}

.cat-emoji {
  font-size: 48rpx;
  opacity: 0.6;
}

.cat-emoji:nth-child(2) {
  animation-delay: 0.2s;
}

.cat-emoji:nth-child(3) {
  animation-delay: 0.4s;
}

.version-text {
  font-size: 22rpx;
  color: #999;
  opacity: 0.6;
}
