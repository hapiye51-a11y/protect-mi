/* 我的发布页面 */
page {
  background: #F5F5F5;
  min-height: 100vh;
}

/* 自定义导航栏 */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 180rpx;
  background: linear-gradient(135deg, #FF9800 0%, #FFB74D 100%);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 24rpx;
  z-index: 999;
}

.navbar-back {
  position: absolute;
  left: 20rpx;
  bottom: 20rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 48rpx;
  color: #FFFFFF;
  font-weight: 300;
}

.navbar-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.container {
  padding: 200rpx 20rpx 180rpx;
}

/* 统计卡片 */
.stats-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-item:active {
  opacity: 0.7;
}

.stat-number {
  font-size: 44rpx;
  font-weight: 700;
  color: #FF9800;
  line-height: 1;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  font-weight: 400;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: #E5E5E5;
}

/* 发布列表 */
.posts-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.post-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  display: flex;
  transition: all 0.3s ease;
  position: relative;
}

.post-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

/* 左侧图片 - 正方形 */
.post-image-container {
  position: relative;
  width: 240rpx;
  height: 240rpx;
  flex-shrink: 0;
}

.post-image {
  width: 100%;
  height: 100%;
  display: block;
}

.status-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  backdrop-filter: blur(10rpx);
}

.status-pending {
  background: rgba(255, 152, 0, 0.9);
  color: #FFFFFF;
}

.status-published {
  background: rgba(76, 175, 80, 0.9);
  color: #FFFFFF;
}

.status-rejected {
  background: rgba(244, 67, 54, 0.9);
  color: #FFFFFF;
}

/* 右侧信息 */
.post-info {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  justify-content: space-between;
}

.post-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.post-type {
  font-size: 24rpx;
  color: #FF9800;
  background: #FFF4ED;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  font-weight: 600;
}

.post-time {
  font-size: 22rpx;
  color: #999999;
}

.post-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
}

.post-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.meta-item {
  font-size: 22rpx;
  color: #666666;
  line-height: 1.4;
}

.risk-level {
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  font-weight: 600;
  font-size: 20rpx;
}

.risk-high {
  background: #FFEBEE;
  color: #FF5252;
}

.risk-medium {
  background: #FFF5E6;
  color: #FF9800;
}

.risk-low {
  background: #FFFDE7;
  color: #FFC107;
}

/* 右上角操作按钮 */
.post-actions-top {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  display: flex;
  gap: 12rpx;
  z-index: 10;
}

.action-icon {
  width: 56rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  font-size: 28rpx;
}

.action-icon:active {
  transform: scale(0.9);
  background: rgba(255, 255, 255, 0.8);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  line-height: 1;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #666666;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999999;
  line-height: 1.6;
  margin-bottom: 48rpx;
}

.empty-actions {
  display: flex;
  gap: 16rpx;
  width: 100%;
  max-width: 500rpx;
}

.action-button {
  flex: 1;
  padding: 24rpx 32rpx;
  background: linear-gradient(135deg, #FF9800 0%, #FFB74D 100%);
  border-radius: 48rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(255, 152, 0, 0.4);
  transition: all 0.3s ease;
}

.action-button:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(255, 152, 0, 0.3);
}

.action-button.secondary {
  background: #FFFFFF;
  color: #FF9800;
  border: 2rpx solid #FF9800;
  box-shadow: 0 4rpx 16rpx rgba(0, 255, 152, 0, 0.15);
}


