.page {
  min-height: 100vh;
  background: #F5F9F5;
  padding-bottom: 40rpx;
}

.section {
  margin-top: 24rpx;
}

.section-title {
  display: block;
  padding: 24rpx 32rpx 16rpx;
  font-size: 26rpx;
  color: #999;
}

.list {
  background: #fff;
}

.item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.item:last-child {
  border-bottom: none;
}

.item.clickable:active {
  background: #f9f9f9;
}

.left {
  flex: 1;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.desc {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.arrow {
  font-size: 32rpx;
  color: #ccc;
}

/* Switch 样式 */
switch {
  transform: scale(0.8);
}
