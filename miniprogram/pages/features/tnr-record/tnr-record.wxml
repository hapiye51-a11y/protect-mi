<view class="container">
  <!-- 进度指示 -->
  <view class="progress-bar">
    <view class="progress-step {{step >= 1 ? 'active' : ''}} {{step > 1 ? 'done' : ''}}">
      <view class="step-dot">{{step > 1 ? '✓' : '1'}}</view>
      <text class="step-label">猫咪信息</text>
    </view>
    <view class="progress-line {{step > 1 ? 'done' : ''}}"></view>
    <view class="progress-step {{step >= 2 ? 'active' : ''}} {{step > 2 ? 'done' : ''}}">
      <view class="step-dot">{{step > 2 ? '✓' : '2'}}</view>
      <text class="step-label">手术信息</text>
    </view>
    <view class="progress-line {{step > 2 ? 'done' : ''}}"></view>
    <view class="progress-step {{step >= 3 ? 'active' : ''}}">
      <view class="step-dot">3</view>
      <text class="step-label">放归信息</text>
    </view>
  </view>

  <!-- 步骤1：猫咪信息 -->
  <view class="form-section" wx:if="{{step === 1}}">
    <view class="section-title">🐱 猫咪信息</view>
    
    <view class="form-item">
      <view class="form-label">
        <text class="label-text">猫咪照片</text>
        <text class="label-required">*</text>
      </view>
      <view class="photo-grid">
        <block wx:for="{{photos}}" wx:key="index">
          <view class="photo-item">
            <image class="photo-preview" src="{{item}}" mode="aspectFill" bindtap="previewPhoto" data-url="{{item}}" />
            <view class="photo-delete" bindtap="deletePhoto" data-index="{{index}}">×</view>
          </view>
        </block>
        <view class="photo-add" wx:if="{{photos.length < 3}}" bindtap="choosePhoto">
          <text class="add-icon">+</text>
        </view>
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">
        <text class="label-text">猫咪名称/代号</text>
        <text class="label-required">*</text>
      </view>
      <input class="form-input" placeholder="如：橘猫-大黄、三花-小花" value="{{catName}}" bindinput="onCatNameInput" />
    </view>

    <view class="form-item">
      <view class="form-label">
        <text class="label-text">性别</text>
        <text class="label-required">*</text>
      </view>
      <view class="gender-options">
        <view class="gender-option {{gender === 'male' ? 'active' : ''}}" bindtap="selectGender" data-gender="male">
          <text class="gender-icon">♂</text>
          <text class="gender-text">公猫</text>
        </view>
        <view class="gender-option {{gender === 'female' ? 'active' : ''}}" bindtap="selectGender" data-gender="female">
          <text class="gender-icon">♀</text>
          <text class="gender-text">母猫</text>
        </view>
        <view class="gender-option {{gender === 'unknown' ? 'active' : ''}}" bindtap="selectGender" data-gender="unknown">
          <text class="gender-icon">❓</text>
          <text class="gender-text">未知</text>
        </view>
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">
        <text class="label-text">年龄估计</text>
      </view>
      <picker mode="selector" range="{{ageOptions}}" range-key="label" value="{{ageIndex}}" bindchange="onAgeChange">
        <view class="form-picker">
          <text class="picker-value">{{ageOptions[ageIndex].label}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <view class="form-item">
      <view class="form-label">
        <text class="label-text">捕获地点</text>
        <text class="label-required">*</text>
      </view>
      <view class="form-picker" bindtap="chooseLocation">
        <text class="picker-value {{location ? '' : 'placeholder'}}">{{location ? location.name : '点击选择地点'}}</text>
        <text class="picker-arrow">›</text>
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">
        <text class="label-text">备注</text>
      </view>
      <textarea class="form-textarea" placeholder="猫咪特征、健康状况等" value="{{notes}}" bindinput="onNotesInput" maxlength="200" />
    </view>
  </view>

  <!-- 步骤2：手术信息 -->
  <view class="form-section" wx:if="{{step === 2}}">
    <view class="section-title">🏥 手术信息</view>

    <view class="form-item">
      <view class="form-label">
        <text class="label-text">合作医院</text>
        <text class="label-required">*</text>
      </view>
      <picker mode="selector" range="{{hospitals}}" range-key="name" value="{{hospitalIndex}}" bindchange="onHospitalChange">
        <view class="form-picker">
          <text class="picker-value">{{hospitals[hospitalIndex].name}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <view class="form-item">
      <view class="form-label">
        <text class="label-text">手术日期</text>
        <text class="label-required">*</text>
      </view>
      <picker mode="date" value="{{surgeryDate}}" start="2020-01-01" end="{{today}}" bindchange="onSurgeryDateChange">
        <view class="form-picker">
          <text class="picker-value">{{surgeryDate || '请选择日期'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <view class="form-item">
      <view class="form-label">
        <text class="label-text">手术类型</text>
        <text class="label-required">*</text>
      </view>
      <view class="type-options">
        <view class="type-option {{surgeryType === 'neuter' ? 'active' : ''}}" bindtap="selectSurgeryType" data-type="neuter">
          <text class="type-text">绝育手术</text>
        </view>
        <view class="type-option {{surgeryType === 'other' ? 'active' : ''}}" bindtap="selectSurgeryType" data-type="other">
          <text class="type-text">其他手术</text>
        </view>
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">
        <text class="label-text">耳标标记</text>
      </view>
      <view class="earmark-options">
        <view class="earmark-option {{earmark === 'left' ? 'active' : ''}}" bindtap="selectEarmark" data-earmark="left">
          <text class="earmark-text">左耳缺口</text>
        </view>
        <view class="earmark-option {{earmark === 'right' ? 'active' : ''}}" bindtap="selectEarmark" data-earmark="right">
          <text class="earmark-text">右耳缺口</text>
        </view>
        <view class="earmark-option {{earmark === 'none' ? 'active' : ''}}" bindtap="selectEarmark" data-earmark="none">
          <text class="earmark-text">无标记</text>
        </view>
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">
        <text class="label-text">疫苗情况</text>
      </view>
      <view class="vaccine-options">
        <view class="vaccine-option {{vaccine === 'rabies' ? 'active' : ''}}" bindtap="toggleVaccine" data-vaccine="rabies">
          <text class="vaccine-icon">💉</text>
          <text class="vaccine-text">狂犬疫苗</text>
          <text class="vaccine-check" wx:if="{{vaccine === 'rabies'}}">✓</text>
        </view>
        <view class="vaccine-option {{vaccine === 'cat' ? 'active' : ''}}" bindtap="toggleVaccine" data-vaccine="cat">
          <text class="vaccine-icon">💉</text>
          <text class="vaccine-text">猫三联</text>
          <text class="vaccine-check" wx:if="{{vaccine === 'cat'}}">✓</text>
        </view>
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">
        <text class="label-text">手术费用</text>
      </view>
      <input class="form-input" type="digit" placeholder="输入费用（元）" value="{{cost}}" bindinput="onCostInput" />
    </view>
  </view>

  <!-- 步骤3：放归信息 -->
  <view class="form-section" wx:if="{{step === 3}}">
    <view class="section-title">🏡 放归信息</view>

    <view class="form-item">
      <view class="form-label">
        <text class="label-text">放归状态</text>
        <text class="label-required">*</text>
      </view>
      <view class="status-options">
        <view class="status-option {{releaseStatus === 'done' ? 'active' : ''}}" bindtap="selectReleaseStatus" data-status="done">
          <text class="status-icon">✅</text>
          <text class="status-text">已放归</text>
        </view>
        <view class="status-option {{releaseStatus === 'recovery' ? 'active' : ''}}" bindtap="selectReleaseStatus" data-status="recovery">
          <text class="status-icon">🏥</text>
          <text class="status-text">康复中</text>
        </view>
        <view class="status-option {{releaseStatus === 'pending' ? 'active' : ''}}" bindtap="selectReleaseStatus" data-status="pending">
          <text class="status-icon">⏳</text>
          <text class="status-text">待放归</text>
        </view>
      </view>
    </view>

    <view class="form-item" wx:if="{{releaseStatus === 'done'}}">
      <view class="form-label">
        <text class="label-text">放归日期</text>
        <text class="label-required">*</text>
      </view>
      <picker mode="date" value="{{releaseDate}}" start="2020-01-01" end="{{today}}" bindchange="onReleaseDateChange">
        <view class="form-picker">
          <text class="picker-value">{{releaseDate || '请选择日期'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <view class="form-item" wx:if="{{releaseStatus === 'done'}}">
      <view class="form-label">
        <text class="label-text">放归地点</text>
        <text class="label-required">*</text>
      </view>
      <view class="form-picker" bindtap="chooseReleaseLocation">
        <text class="picker-value {{releaseLocation ? '' : 'placeholder'}}">{{releaseLocation ? releaseLocation.name : '点击选择地点'}}</text>
        <text class="picker-arrow">›</text>
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">
        <text class="label-text">后续观察</text>
      </view>
      <textarea class="form-textarea" placeholder="猫咪放归后的状态、是否定期投喂等" value="{{followUp}}" bindinput="onFollowUpInput" maxlength="200" />
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="btn-section">
    <button class="btn-secondary" wx:if="{{step > 1}}" bindtap="prevStep">上一步</button>
    <button class="btn-primary {{canNext ? '' : 'disabled'}}" bindtap="nextStep">
      <text wx:if="{{step < 3}}">下一步</text>
      <text wx:else>提交记录</text>
    </button>
  </view>
</view>
