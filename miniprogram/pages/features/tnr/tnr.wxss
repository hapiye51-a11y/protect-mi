/* TNR记录页面 */
.container {
  min-height: 100vh;
  background: #F5F9F5;
  padding-bottom: 40rpx;
}

.stats-card {
  display: flex;
  margin: 24rpx;
  padding: 28rpx;
  background: linear-gradient(135deg, #4CAF50 0%, #66BB6A 100%);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.2);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 4rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin: 0 24rpx 24rpx;
}

.action-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.08);
  transition: all 0.3s ease;
}

.action-card:active {
  transform: scale(0.98);
  background: #F5F9F5;
}

.action-icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 12rpx;
}

.action-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 4rpx;
}

.action-desc {
  font-size: 22rpx;
  color: #888;
}

.record-section {
  margin: 0 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}

.section-count {
  font-size: 24rpx;
  color: #888;
}

.record-list {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #F5F9F5;
  transition: background 0.3s ease;
}

.record-item:active {
  background: #F5F9F5;
}

.record-image {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  background: #E8F5E9;
}

.record-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  background: #E8F5E9;
  border-radius: 12rpx;
  margin-right: 16rpx;
}

.record-status {
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.record-status.done {
  background: rgba(76, 175, 80, 0.15);
  color: #4CAF50;
}

.record-status.progress {
  background: rgba(255, 152, 0, 0.15);
  color: #FF9800;
}

.record-status.pending {
  background: rgba(158, 158, 158, 0.15);
  color: #9E9E9E;
}

.record-info {
  flex: 1;
  min-width: 0;
}

.record-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-meta {
  font-size: 22rpx;
  color: #888;
  margin-top: 4rpx;
}

.record-arrow {
  font-size: 32rpx;
  color: #CCC;
  margin-left: 8rpx;
}

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 60rpx 0;
  background: #FFFFFF;
  border-radius: 20rpx;
}

.loading-icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 12rpx;
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.loading-text {
  font-size: 26rpx;
  color: #888;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 60rpx 0;
  background: #FFFFFF;
  border-radius: 20rpx;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #888;
}
