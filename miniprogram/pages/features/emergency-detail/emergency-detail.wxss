.container {
  min-height: 100vh;
  background: #f5f9f5;
}

/* 头部 */
.header {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.header-icon {
  font-size: 60rpx;
  margin-right: 20rpx;
}

.header-info {
  flex: 1;
}

.header-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 8rpx;
}

.urgency-badge {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.urgency-badge.level-high {
  background: rgba(244, 67, 54, 0.1);
  color: #F44336;
}

.urgency-badge.level-medium {
  background: rgba(255, 152, 0, 0.1);
  color: #FF9800;
}

/* 摘要卡片 */
.summary-card {
  background: #fff;
  margin: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  border-left: 6rpx solid #4CAF50;
}

.summary-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

/* 步骤区域 */
.steps-section {
  background: #fff;
  margin: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}

.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.title-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
}

.title-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.steps-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.step-item {
  padding: 16rpx;
  background: #f5f9f5;
  border-radius: 12rpx;
}

.step-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
  white-space: pre-wrap;
}

/* 警告卡片 */
.warning-card {
  background: rgba(244, 67, 54, 0.08);
  margin: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: flex-start;
}

.warning-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.warning-text {
  font-size: 26rpx;
  color: #F44336;
  line-height: 1.5;
  flex: 1;
}

/* 底部操作 */
.footer-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.05);
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  border: none;
}

.action-btn.secondary {
  background: #f5f5f5;
  color: #666;
}

.action-btn.primary {
  background: #4CAF50;
  color: #fff;
}

.bottom-space {
  height: 160rpx;
}
