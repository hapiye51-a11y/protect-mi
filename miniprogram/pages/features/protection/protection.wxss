/* 守护盾牌页面 */
.page {
  min-height: 100vh;
  background: #F5F9F5;
  padding-bottom: 40rpx;
}

/* 头部 */
.header {
  padding: 40rpx 32rpx;
  background: linear-gradient(135deg, #4CAF50 0%, #66BB6A 100%);
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #FFFFFF;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 12rpx;
}

/* 快捷操作（置顶） */
.quick-actions {
  display: flex;
  padding: 24rpx;
  gap: 16rpx;
  background: #FFFFFF;
  margin: -20rpx 24rpx 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(76, 175, 80, 0.15);
}

.action-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 12rpx;
  background: #F5F9F5;
  border-radius: 16rpx;
}

.action-item.emergency {
  background: #FFEBEE;
}

.action-icon {
  font-size: 44rpx;
  margin-bottom: 12rpx;
}

.action-label {
  font-size: 24rpx;
  font-weight: bold;
  color: #333;
}

/* 区块 */
.section {
  margin: 0 24rpx 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

/* 紧急联系 */
.contact-list {
  /* 无 */
}

.contact-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.contact-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.contact-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.contact-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.contact-desc {
  font-size: 24rpx;
  color: #888;
}

.call-btn {
  padding: 12rpx 24rpx;
  background: #4CAF50;
  border-radius: 20rpx;
}

.call-btn text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: bold;
}

/* 话术模板 */
.template-box {
  background: #F5F9F5;
  border-radius: 16rpx;
  padding: 24rpx;
}

.template-text {
  display: block;
  font-size: 26rpx;
  color: #333;
  line-height: 1.8;
  margin-bottom: 20rpx;
}

.copy-btn {
  display: flex;
  justify-content: center;
  padding: 16rpx;
  background: #4CAF50;
  border-radius: 12rpx;
}

.copy-btn text {
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: bold;
}

/* 取证步骤 */
.steps {
  /* 无 */
}

.step {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.step:last-child {
  border-bottom: none;
}

.step-num {
  width: 48rpx;
  height: 48rpx;
  background: #4CAF50;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.step-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.step-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.step-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
}

/* 警告 */
.warning-box {
  display: flex;
  align-items: center;
  margin: 0 24rpx;
  padding: 24rpx;
  background: #FFF3E0;
  border-radius: 16rpx;
}

.warning-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.warning-content {
  flex: 1;
}

.warning-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #FF9800;
}

.warning-desc {
  display: block;
  font-size: 24rpx;
  color: #888;
  margin-top: 6rpx;
}
