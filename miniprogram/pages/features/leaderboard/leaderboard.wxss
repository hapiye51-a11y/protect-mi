/* 爱心榜单页面 */
page {
  background: linear-gradient(135deg, #FFF9F0 0%, #F8F9FA 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', sans-serif;
}

.container {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 我的排名卡片 */
.my-rank-card {
  background: linear-gradient(135deg, #FF9800 0%, #FFB74D 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 152, 0, 0.3);
}

.rank-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.rank-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.rank-badge {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.3);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.rank-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.rank-avatar {
  font-size: 48rpx;
  line-height: 1;
}

.rank-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  flex: 1;
}

.rank-count {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 榜单区域 */
.leaderboard-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.section-header {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
}

.section-desc {
  font-size: 24rpx;
  color: #999999;
}

/* 榜单列表 */
.leaderboard-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.leaderboard-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, #FFF9F0 0%, #FFFFFF 100%);
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.leaderboard-item:active {
  transform: scale(0.98);
  background: linear-gradient(135deg, #FFF3E0 0%, #FFFFFF 100%);
}

.leaderboard-item.top-three {
  background: linear-gradient(135deg, #FFE5CC 0%, #FFFFFF 100%);
  box-shadow: 0 4rpx 12rpx rgba(255, 152, 0, 0.15);
}

.item-rank {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rank-number {
  font-size: 28rpx;
  font-weight: 700;
  color: #FF9800;
}

.leaderboard-item.top-three .rank-number {
  font-size: 32rpx;
}

.item-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #F0F0F0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-emoji {
  font-size: 36rpx;
  line-height: 1;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.item-count {
  font-size: 22rpx;
  color: #999999;
}

.item-action {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-icon {
  font-size: 32rpx;
  line-height: 1;
}

/* 分享按钮 */
.share-section {
  margin-top: 32rpx;
}

.share-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #FF9800 0%, #FFB74D 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 152, 0, 0.3);
  border: none;
  transition: all 0.3s ease;
}

.share-btn:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(255, 152, 0, 0.2);
}

.share-icon {
  font-size: 36rpx;
  line-height: 1;
}

.share-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}
