/* 猫咪匹配页面 */
.container {
  min-height: 100vh;
  background: #F5F9F5;
}

.tab-bar {
  display: flex;
  background: #FFFFFF;
  padding: 16rpx 24rpx;
  gap: 16rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.tab-item {
  flex: 1;
  padding: 20rpx 0;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  color: #666;
  border-radius: 24rpx;
  background: #F5F9F5;
  transition: all 0.3s ease;
}

.tab-item.active {
  background: linear-gradient(135deg, #4CAF50 0%, #66BB6A 100%);
  color: #FFFFFF;
}

.content-area {
  padding: 24rpx;
}

.post-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.1);
  transition: all 0.3s ease;
}

.post-btn:active {
  transform: scale(0.98);
  background: #F5F9F5;
}

.post-icon {
  font-size: 32rpx;
}

.post-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #4CAF50;
}

.card-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.match-card {
  display: flex;
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.08);
  transition: all 0.3s ease;
}

.match-card:active {
  transform: scale(0.99);
  box-shadow: 0 2rpx 8rpx rgba(76, 175, 80, 0.12);
}

.card-image {
  width: 200rpx;
  height: 200rpx;
  background: #E8F5E9;
  flex-shrink: 0;
}

.card-info {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}

.card-reward {
  font-size: 24rpx;
  font-weight: 600;
  color: #FF9800;
  background: rgba(255, 152, 0, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.card-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  flex: 1;
}

.card-meta {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.meta-item {
  font-size: 22rpx;
  color: #888;
}

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 80rpx 0;
}

.loading-icon {
  font-size: 60rpx;
  display: block;
  margin-bottom: 16rpx;
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.loading-text {
  font-size: 28rpx;
  color: #888;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 24rpx;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 12rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: #999;
  display: block;
}
