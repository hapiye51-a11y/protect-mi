/* 提问页面 */
.page {
  min-height: 100vh;
  background: #F5F9F5;
  padding: 24rpx;
  padding-bottom: 120rpx;
}

.section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

/* 类型选择 */
.types {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.type {
  padding: 16rpx 24rpx;
  background: #F5F9F5;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}

.type.active {
  background: rgba(76, 175, 80, 0.1);
  border-color: #4CAF50;
}

.type text {
  font-size: 26rpx;
  color: #666;
}

.type.active text {
  color: #4CAF50;
}

/* 输入框 */
.input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  background: #F5F9F5;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  background: #F5F9F5;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 图片 */
.photos {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.photo image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 36rpx;
  height: 36rpx;
  background: #FF5252;
  border-radius: 50%;
  color: #FFF;
  font-size: 24rpx;
  text-align: center;
  line-height: 36rpx;
}

.add-photo {
  width: 160rpx;
  height: 160rpx;
  background: #F5F9F5;
  border: 2rpx dashed #4CAF50;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-photo text {
  font-size: 48rpx;
  color: #4CAF50;
}

/* 按钮 */
.btn-area {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
}

.btn {
  width: 100%;
  height: 88rpx;
  background: #4CAF50;
  border-radius: 44rpx;
  color: #FFF;
  font-size: 32rpx;
  font-weight: bold;
}
