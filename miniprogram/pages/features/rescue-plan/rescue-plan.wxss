/* 救助计划 */
.page{min-height:100vh;background:#F5F9F5;padding:24rpx;box-sizing:border-box}

/* 统计 */
.stats{display:flex;background:#4CAF50;border-radius:20rpx;padding:28rpx;margin-bottom:20rpx}
.stat{flex:1;text-align:center}
.num{display:block;font-size:44rpx;font-weight:bold;color:#FFF}
.txt{display:block;font-size:22rpx;color:rgba(255,255,255,0.9);margin-top:4rpx}
.line{width:1rpx;background:rgba(255,255,255,0.3);margin:6rpx 0}

/* 添加按钮 */
.add{background:#FFF;border-radius:16rpx;padding:26rpx;text-align:center;margin-bottom:20rpx;font-size:28rpx;font-weight:bold;color:#4CAF50}

/* 筛选 */
.filters{display:flex;background:#FFF;border-radius:16rpx;padding:6rpx;margin-bottom:20rpx}
.filter{flex:1;text-align:center;padding:14rpx 0;border-radius:12rpx;font-size:26rpx;color:#666}
.filter.on{background:#4CAF50;color:#FFF}

/* 列表 */
.item{display:flex;align-items:flex-start;background:#FFF;border-radius:16rpx;padding:20rpx;margin-bottom:14rpx}
.item.done{opacity:.6}
.item.done .name{text-decoration:line-through;color:#999}
.check{width:38rpx;height:38rpx;border:3rpx solid #4CAF50;border-radius:50%;margin-right:14rpx;margin-top:6rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.item.done .check{background:#4CAF50}
.check text{font-size:22rpx;color:#FFF}
.info{flex:1;min-width:0}
.row1{display:flex;align-items:center;margin-bottom:6rpx}
.tag{font-size:20rpx;color:#4CAF50;background:rgba(76,175,80,.15);padding:4rpx 10rpx;border-radius:6rpx;margin-right:10rpx;flex-shrink:0}
.name{font-size:28rpx;font-weight:bold;color:#333;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.desc{display:block;font-size:24rpx;color:#666;margin-bottom:6rpx;line-height:1.4}
.row2{display:flex;flex-wrap:wrap;gap:10rpx}
.row2 text{font-size:20rpx;color:#888}
.go{font-size:26rpx;color:#CCC;margin-left:8rpx;flex-shrink:0}

/* 空状态 */
.empty{text-align:center;padding:80rpx 0}
.icon{display:block;font-size:64rpx;margin-bottom:12rpx}
.msg{display:block;font-size:28rpx;color:#333;margin-bottom:6rpx}
.tip{display:block;font-size:22rpx;color:#888}

/* 弹窗 */
.mask{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index:100}
.modal{position:fixed;left:24rpx;right:24rpx;bottom:24rpx;background:#FFF;border-radius:20rpx;z-index:101;max-height:80vh;overflow-y:auto}
.mhead{display:flex;align-items:center;justify-content:space-between;padding:22rpx;border-bottom:1rpx solid #EEE}
.mtitle{font-size:30rpx;font-weight:bold;color:#333}
.mclose{font-size:34rpx;color:#999}
.mbody{padding:20rpx}
.row{margin-bottom:20rpx}
.label{display:block;font-size:26rpx;font-weight:bold;color:#333;margin-bottom:10rpx}
.types{display:flex;flex-wrap:wrap;gap:10rpx}
.tp{padding:10rpx 14rpx;background:#F5F9F5;border-radius:8rpx;font-size:22rpx;color:#666;border:2rpx solid transparent}
.tp.tpon{background:rgba(76,175,80,.15);border-color:#4CAF50;color:#4CAF50}
.inp{width:100%;height:72rpx;padding:0 16rpx;background:#F5F9F5;border-radius:8rpx;font-size:26rpx;box-sizing:border-box}
.ta{width:100%;min-height:90rpx;padding:14rpx 16rpx;background:#F5F9F5;border-radius:8rpx;font-size:26rpx;box-sizing:border-box}
.pick{padding:18rpx 16rpx;background:#F5F9F5;border-radius:8rpx}
.pick text{font-size:26rpx;color:#333}
.mfoot{display:flex;gap:10rpx;padding:20rpx;border-top:1rpx solid #EEE}
.btn{flex:1;height:72rpx;line-height:72rpx;text-align:center;border-radius:36rpx;font-size:26rpx}
.cancel{background:#F5F9F5;color:#666}
.save{flex:2;background:#4CAF50;color:#FFF;font-weight:bold}
.del{width:90rpx;flex:none;background:#FFEBEE;color:#FF5252}
