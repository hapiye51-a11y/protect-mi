/* 问题详情页 */
.page {
  min-height: 100vh;
  background: #F5F9F5;
  padding-bottom: 120rpx;
}

/* 问题区 */
.question {
  background: #FFFFFF;
  padding: 24rpx;
  margin: 24rpx;
  border-radius: 20rpx;
}

.q-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.q-type {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  background: #E8F5E9;
  color: #4CAF50;
  border-radius: 12rpx;
}

.q-time {
  font-size: 24rpx;
  color: #999;
}

.q-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.q-author {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.q-images {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.q-images image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
}

.q-content {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

/* 回答区 */
.answers {
  background: #FFFFFF;
  margin: 0 24rpx 24rpx;
  border-radius: 20rpx;
  padding: 24rpx;
}

.a-header {
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.a-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.a-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.a-item:last-child {
  border-bottom: none;
}

.a-user {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.a-avatar {
  width: 48rpx;
  height: 48rpx;
  background: #E8F5E9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
}

.a-avatar text {
  font-size: 24rpx;
}

.a-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.a-time {
  font-size: 22rpx;
  color: #999;
}

.a-content {
  display: block;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.a-actions {
  display: flex;
  gap: 24rpx;
}

.a-action text {
  font-size: 24rpx;
  color: #666;
}

/* 回复列表 */
.replies {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #F5F9F5;
  border-radius: 12rpx;
}

.reply-item {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #E8E8E8;
}

.reply-item:last-child {
  border-bottom: none;
}

.reply-user {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 6rpx;
}

.reply-name {
  font-size: 24rpx;
  font-weight: bold;
  color: #333;
}

.reply-to {
  font-size: 22rpx;
  color: #4CAF50;
}

.reply-content {
  display: block;
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
}

.reply-time {
  display: block;
  font-size: 20rpx;
  color: #999;
  margin-top: 6rpx;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 40rpx 0;
}

.empty-icon {
  display: block;
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #999;
}

/* 底部回答 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  background: #F5F9F5;
  border-radius: 36rpx;
  font-size: 28rpx;
}

.btn {
  margin-left: 16rpx;
  padding: 16rpx 32rpx;
  background: #4CAF50;
  border-radius: 36rpx;
}

.btn text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: bold;
}
