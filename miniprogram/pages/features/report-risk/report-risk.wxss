/* 风险上报页面 */
page {
  background: #F5F5F5;
  min-height: 100vh;
}

.container {
  padding: 20rpx;
  padding-bottom: 180rpx;
}

/* 返回按钮 */
.back-button {
  position: fixed;
  top: 40rpx;
  left: 20rpx;
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10rpx);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  z-index: 999;
  transition: all 0.3s ease;
}

.back-button:active {
  transform: scale(0.9);
  background: rgba(255, 255, 255, 0.7);
}

.back-icon {
  font-size: 36rpx;
  color: #333333;
  font-weight: 300;
}

/* ========== 顶部提示卡片 ========== */
.tip-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #FFF5E6 0%, #FFE5CC 100%);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 152, 0, 0.15);
}

.tip-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.tip-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.tip-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #FF9800;
}

.tip-desc {
  font-size: 24rpx;
  color: #B45309;
  line-height: 1.5;
}

/* ========== 表单区域 ========== */
.form-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.form-item {
  margin-bottom: 40rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

/* 标签 */
.item-label {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.label-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.label-required {
  color: #FF5252;
  font-size: 32rpx;
  margin-left: 6rpx;
}

.label-optional {
  font-size: 24rpx;
  color: #999999;
  margin-left: 8rpx;
}

/* ========== 照片上传 ========== */
.photo-upload {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.photo-preview {
  width: 100%;
  height: 100%;
  display: block;
}

.photo-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 48rpx;
  height: 48rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-icon {
  font-size: 36rpx;
  color: #FFFFFF;
  font-weight: 300;
}

.photo-add {
  width: 200rpx;
  height: 200rpx;
  border: 3rpx dashed #D8D8D8;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: all 0.3s ease;
}

.photo-add:active {
  border-color: #FF9800;
  background: #FFF8F0;
}

.add-icon {
  font-size: 56rpx;
}

.add-text {
  font-size: 26rpx;
  color: #666666;
}

.add-hint {
  font-size: 22rpx;
  color: #999999;
}

/* ========== 风险等级 ========== */
.risk-level-group {
  display: flex;
  gap: 16rpx;
}

.level-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 16rpx;
  border: 3rpx solid #E8E8E8;
  border-radius: 16rpx;
  background: #FAFAFA;
  transition: all 0.3s ease;
}

.level-btn:active {
  transform: scale(0.95);
}

.level-btn.active {
  border-color: #FF9800;
  background: #FFF5E6;
}

.level-btn.active.high {
  border-color: #FF5252;
  background: #FFEBEE;
}

.level-btn.active.medium {
  border-color: #FF9800;
  background: #FFF5E6;
}

.level-btn.active.low {
  border-color: #FFC107;
  background: #FFFDE7;
}

.level-emoji {
  font-size: 48rpx;
}

.level-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #666666;
}

.level-btn.active .level-text {
  color: #333333;
}

/* ========== 风险类型 ========== */
.risk-type-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.type-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  border: 2rpx solid #E8E8E8;
  border-radius: 48rpx;
  background: #FAFAFA;
  transition: all 0.3s ease;
}

.type-tag:active {
  transform: scale(0.95);
}

.type-tag.active {
  border-color: #FF9800;
  background: linear-gradient(135deg, #FFF5E6 0%, #FFE5CC 100%);
  box-shadow: 0 2rpx 8rpx rgba(255, 152, 0, 0.2);
}

.type-icon {
  font-size: 32rpx;
}

.type-text {
  font-size: 26rpx;
  color: #666666;
  font-weight: 500;
}

.type-tag.active .type-text {
  color: #FF9800;
  font-weight: 600;
}

/* ========== 位置卡片 ========== */
.location-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: #F8F8F8;
  border-radius: 16rpx;
  border: 2rpx solid #E8E8E8;
  transition: all 0.3s ease;
}

.location-card:active {
  background: #F0F0F0;
  border-color: #FF9800;
}

.location-icon {
  font-size: 48rpx;
  flex-shrink: 0;
}

.location-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.location-address {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.location-detail {
  font-size: 22rpx;
  color: #999999;
}

.location-arrow {
  font-size: 48rpx;
  color: #CCCCCC;
  flex-shrink: 0;
}

/* ========== 文本输入 ========== */
.textarea-input {
  width: 100%;
  min-height: 240rpx;
  padding: 20rpx;
  background: #F8F8F8;
  border-radius: 16rpx;
  border: 2rpx solid #E8E8E8;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

.textarea-counter {
  text-align: right;
  font-size: 22rpx;
  color: #999999;
  margin-top: 8rpx;
}

.text-input {
  width: 100%;
  height: 88rpx;
  padding: 0 20rpx;
  background: #F8F8F8;
  border-radius: 16rpx;
  border: 2rpx solid #E8E8E8;
  font-size: 28rpx;
  color: #333333;
}

/* ========== 提交按钮 ========== */
.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #FF9800 0%, #FFB74D 100%);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(255, 152, 0, 0.4);
  border: none;
  transition: all 0.3s ease;
}

.submit-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(255, 152, 0, 0.3);
}

.submit-btn.disabled {
  background: #E8E8E8;
  box-shadow: none;
  opacity: 0.6;
}

.submit-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 1rpx;
}

.submit-tip {
  text-align: center;
  padding: 16rpx 0 8rpx;
}

.tip-text {
  font-size: 22rpx;
  color: #999999;
  line-height: 1.5;
}
