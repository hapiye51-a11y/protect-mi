/* ========== 猫咪档案列表 - 升级版 ========== */

.container {
  min-height: 100vh;
  background: #f8f9fa;
  padding-bottom: 120rpx;
}

/* ========== 顶部区域 ========== */
.header-section {
  position: relative;
  padding-bottom: 20rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 280rpx;
  background: linear-gradient(135deg, #FF9800 0%, #F57C00 50%, #EF6C00 100%);
  border-radius: 0 0 60rpx 60rpx;
  overflow: hidden;
}

.header-decorate {
  position: absolute;
  right: 30rpx;
  top: 20rpx;
  display: flex;
  gap: 16rpx;
  opacity: 0.3;
}

.decorate-emoji {
  font-size: 48rpx;
}

.header-content {
  position: relative;
  padding: 60rpx 30rpx 30rpx;
  color: #fff;
}

.header-title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 统计卡片 */
.stats-card {
  position: relative;
  margin: 0 30rpx;
  margin-top: 20rpx;
  display: flex;
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 152, 0, 0.15);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.stat-item.highlight .stat-num {
  color: #FF9800;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.stat-divider {
  width: 1rpx;
  background: #f0f0f0;
  margin: 10rpx 0;
}

/* ========== 筛选标签 ========== */
.filter-section {
  padding: 20rpx 0;
  background: #f8f9fa;
}

.filter-scroll {
  white-space: nowrap;
  padding: 0 30rpx;
}

.filter-item {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 28rpx;
  margin-right: 16rpx;
  background: #fff;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.filter-item.active {
  background: linear-gradient(135deg, #FF9800, #F57C00);
  box-shadow: 0 6rpx 20rpx rgba(255, 152, 0, 0.3);
}

.filter-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.filter-text {
  font-size: 26rpx;
  color: #666;
}

.filter-item.active .filter-text {
  color: #fff;
  font-weight: 500;
}

/* ========== 猫咪卡片列表 ========== */
.cats-list {
  padding: 10rpx 30rpx;
}

.cat-card {
  display: flex;
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  transition: all 0.3s ease;
  position: relative;
}

.cat-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1);
}

/* 编辑和删除按钮 */
.card-actions-top {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  display: flex;
  gap: 12rpx;
  z-index: 10;
}

.action-icon {
  width: 56rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  font-size: 28rpx;
}

.action-icon:active {
  transform: scale(0.9);
}

.action-icon.delete {
  background: rgba(255, 255, 255, 0.95);
}

/* 左侧图片 */
.card-image-section {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  flex-shrink: 0;
}

.cat-avatar {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #FFF3E0, #FFE0B2);
}

.status-dot {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.2);
}

.status-available {
  background: #4CAF50;
}

.status-adopted {
  background: #2196F3;
}

.status-treatment {
  background: #FF9800;
}

/* 右侧信息 */
.card-info-section {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.cat-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.gender-icon {
  font-size: 24rpx;
}

.gender-male {
  color: #2196F3;
}

.gender-female {
  color: #E91E63;
}

.status-badge {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.status-badge.status-available {
  background: #E8F5E9;
  color: #4CAF50;
}

.status-badge.status-adopted {
  background: #E3F2FD;
  color: #2196F3;
}

.status-badge.status-treatment {
  background: #FFF3E0;
  color: #FF9800;
}

.status-badge.status-pending {
  background: #FFF8E1;
  color: #FFA000;
}

.status-badge.status-rejected {
  background: #FFEBEE;
  color: #F44336;
}

/* 元信息 */
.card-meta {
  display: flex;
  gap: 24rpx;
  margin-bottom: 12rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.meta-icon {
  font-size: 22rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #666;
}

/* 标签 */
.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: auto;
}

.card-tag {
  padding: 6rpx 14rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  font-size: 22rpx;
  color: #666;
}

.card-tag.location {
  background: #FFF3E0;
  color: #FF9800;
}

/* 底部 */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f5f5f5;
}

.rescue-date {
  font-size: 22rpx;
  color: #999;
}

.arrow {
  font-size: 32rpx;
  color: #ccc;
  font-weight: 300;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.empty-illustration {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.empty-emoji {
  font-size: 60rpx;
  opacity: 0.5;
  animation: bounce 2s ease infinite;
}

.empty-emoji:nth-child(2) {
  animation-delay: 0.2s;
}

.empty-emoji:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.empty-dots {
  display: flex;
  gap: 12rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #e0e0e0;
}

.dot.active {
  width: 36rpx;
  border-radius: 6rpx;
  background: #FF9800;
}

/* ========== 浮动按钮 ========== */
.fab-container {
  position: fixed;
  right: 40rpx;
  bottom: 140rpx;
  z-index: 100;
}

.fab-button {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF9800, #F57C00);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 152, 0, 0.4);
}

.fab-button:active {
  transform: scale(0.9);
}

.fab-icon {
  font-size: 48rpx;
  color: #fff;
  font-weight: 300;
}

.bottom-space {
  height: 60rpx;
}
