.container {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 顶部大图 */
.hero-section {
  position: relative;
  width: 100%;
  height: 500rpx;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  padding: 120rpx 30rpx 30rpx;
  background: linear-gradient(to bottom, rgba(0,0,0,0.3), transparent);
}

.status-badges {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.status-badge {
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #fff;
}

.status-available {
  background: #4CAF50;
}

.status-adopted {
  background: #2196F3;
}

.status-treatment {
  background: #FF9800;
}

.gender-badge {
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #fff;
}

.gender-male {
  background: #2196F3;
}

.gender-female {
  background: #E91E63;
}

.neutered-badge {
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  background: #9C27B0;
  color: #fff;
}

.back-btn {
  position: absolute;
  top: 40rpx;
  left: 30rpx;
  width: 60rpx;
  height: 60rpx;
  background: rgba(255,255,255,0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.15);
}

.back-icon {
  font-size: 40rpx;
  color: #333;
  font-weight: bold;
}

/* 基本信息 */
.info-section {
  background: #fff;
  margin: -40rpx 20rpx 20rpx;
  border-radius: 24rpx;
  padding: 30rpx;
  position: relative;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}

.name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.cat-name {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
}

.personality-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.personality-tag {
  padding: 6rpx 16rpx;
  background: #FFF3E0;
  color: #FF9800;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.basic-info-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.info-item {
  text-align: center;
  padding: 20rpx 0;
  background: #f9f9f9;
  border-radius: 16rpx;
}

.info-value {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.info-label {
  font-size: 22rpx;
  color: #999;
}

/* 快捷入口 */
.quick-actions {
  display: flex;
  justify-content: space-around;
  background: #fff;
  margin: 0 20rpx 20rpx;
  border-radius: 24rpx;
  padding: 30rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.action-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.action-text {
  font-size: 24rpx;
  color: #666;
}

.action-count {
  position: absolute;
  top: -10rpx;
  right: -20rpx;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background: #FF9800;
  color: #fff;
  border-radius: 18rpx;
  font-size: 20rpx;
  padding: 0 8rpx;
}

/* 通用 section */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-more {
  font-size: 26rpx;
  color: #FF9800;
}

/* 救助故事 */
.story-section {
  background: #fff;
  margin: 0 20rpx 20rpx;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}

.story-content {
  font-size: 28rpx;
  line-height: 1.8;
  color: #555;
  margin-bottom: 20rpx;
}

.rescue-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.rescue-date, .rescue-location {
  font-size: 24rpx;
  color: #999;
}

/* 性格描述 */
.description-section {
  background: #fff;
  margin: 0 20rpx 20rpx;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}

.description-content {
  font-size: 28rpx;
  line-height: 1.8;
  color: #555;
}

/* 领养要求 */
.adoption-section {
  background: #fff;
  margin: 0 20rpx 20rpx;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}

.requirement-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.requirement-item {
  display: flex;
  align-items: flex-start;
}

.requirement-dot {
  color: #FF9800;
  font-size: 28rpx;
  margin-right: 12rpx;
}

.requirement-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
}

/* 健康概况 */
.health-summary {
  background: #fff;
  margin: 0 20rpx 20rpx;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}

.health-grid {
  display: flex;
  gap: 20rpx;
}

.health-item {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 16rpx;
}

.health-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.health-info {
  display: flex;
  flex-direction: column;
}

.health-label {
  font-size: 22rpx;
  color: #999;
}

.health-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

/* 最新动态 */
.diary-preview {
  background: #fff;
  margin: 0 20rpx 20rpx;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}

.diary-card {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 16rpx;
}

.diary-image {
  width: 160rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.diary-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.diary-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.diary-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.diary-date {
  font-size: 22rpx;
  color: #999;
  margin-top: auto;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.08);
}

.adopt-btn, .contact-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

.adopt-btn {
  background: #FF9800;
  color: #fff;
}

.contact-btn {
  background: #fff;
  color: #FF9800;
  border: 2rpx solid #FF9800;
}

.btn-icon {
  font-size: 32rpx;
}

.btn-text {
  font-weight: 500;
}

/* 底部留白 */
.bottom-space {
  height: 160rpx;
}
