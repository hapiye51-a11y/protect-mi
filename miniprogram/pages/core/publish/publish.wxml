<view class="container">

  <!-- 顶部装饰 -->
  <view class="header-decoration">
    <text class="cat-paw">🐾</text>
    <text class="cat-paw">🐾</text>
    <text class="cat-paw">🐾</text>
  </view>

  <view class="page-header">
    <text class="header-icon">📢</text>
    <text class="header-title">发布救助信息</text>
    <text class="header-subtitle">让更多人看到，让爱传递</text>
  </view>

  <scroll-view scroll-y class="form-container">
    <!-- 猫咪照片上传 -->
    <view class="form-section">
      <view class="section-label">
        <text class="label-icon">📷</text>
        <text class="label-text">猫咪照片</text>
        <text class="label-required">*</text>
      </view>
      <view class="photo-upload">
        <view class="photo-list">
          <view class="photo-item" wx:for="{{photos}}" wx:key="*this">
            <image class="photo-preview" src="{{item}}" mode="aspectFill" bindtap="previewPhoto" data-url="{{item}}" />
            <view class="photo-delete" bindtap="deletePhoto" data-index="{{index}}">×</view>
          </view>
          <view class="photo-add" wx:if="{{photos.length < 9}}" bindtap="choosePhoto">
            <text class="add-icon">+</text>
            <text class="add-text">添加照片</text>
            <text class="add-count">{{photos.length}}/9</text>
          </view>
        </view>
        <text class="photo-tip">💡 清晰的照片更容易获得关注</text>
      </view>
    </view>

    <!-- 救助类型 -->
    <view class="form-section">
      <view class="section-label">
        <text class="label-icon">🏷️</text>
        <text class="label-text">救助类型</text>
        <text class="label-required">*</text>
      </view>
      <view class="type-tags">
        <view
          class="type-tag {{rescueType === item.value ? 'active' : ''}}"
          wx:for="{{typeOptions}}"
          wx:key="value"
          bindtap="selectType"
          data-value="{{item.value}}">
          <text class="tag-icon">{{item.icon}}</text>
          <text class="tag-text">{{item.label}}</text>
        </view>
      </view>
    </view>

    <!-- 紧急程度 -->
    <view class="form-section">
      <view class="section-label">
        <text class="label-icon">⚠️</text>
        <text class="label-text">紧急程度</text>
      </view>
      <view class="urgency-selector">
        <view
          class="urgency-item level-{{item.value}} {{urgency === item.value ? 'active' : ''}}"
          wx:for="{{urgencyOptions}}"
          wx:key="value"
          bindtap="selectUrgency"
          data-value="{{item.value}}">
          {{item.label}}
        </view>
      </view>
    </view>

    <!-- 猫咪描述 -->
    <view class="form-section">
      <view class="section-label">
        <text class="label-icon">📝</text>
        <text class="label-text">详细描述</text>
        <text class="label-required">*</text>
      </view>
      <textarea
        class="description-input"
        placeholder="请描述猫咪的具体情况：&#10;· 猫咪外观特征（颜色、大小、年龄等）&#10;· 当前状态（受伤、生病、待救助等）&#10;· 发现地点和时间&#10;· 其他重要信息"
        placeholder-class="input-placeholder"
        value="{{description}}"
        bindinput="onDescriptionInput"
        maxlength="500"
        auto-height />
      <view class="char-count">{{description.length}}/500</view>
    </view>

    <!-- 位置信息 -->
    <view class="form-section">
      <view class="section-label">
        <text class="label-icon">📍</text>
        <text class="label-text">位置信息</text>
        <text class="label-required">*</text>
      </view>
      <view class="location-picker" bindtap="chooseLocation">
        <view class="location-info" wx:if="{{location}}">
          <text class="location-name">{{location.name}}</text>
          <text class="location-address">{{location.address}}</text>
        </view>
        <view class="location-placeholder" wx:else>
          <text class="placeholder-icon">📍</text>
          <text class="placeholder-text">点击选择位置</text>
        </view>
        <text class="location-arrow">›</text>
      </view>
      <view class="location-tip">⚠️ 为保护猫咪安全，将自动模糊化位置</view>
    </view>

    <!-- 联系方式 -->
    <view class="form-section">
      <view class="section-label">
        <text class="label-icon">📞</text>
        <text class="label-text">联系方式</text>
      </view>
      <input
        class="contact-input"
        placeholder="手机号或微信号（可选）"
        placeholder-class="input-placeholder"
        value="{{contact}}"
        bindinput="onContactInput"
        maxlength="20" />
      <view class="contact-options">
        <checkbox-group bindchange="onAnonymousChange">
          <label class="anonymous-checkbox">
            <checkbox value="anonymous" checked="{{anonymous}}" />
            <text class="checkbox-text">匿名发布（隐藏联系方式）</text>
          </label>
        </checkbox-group>
      </view>
    </view>

    <!-- 提交按钮 -->
    <view class="submit-section">
      <button class="submit-btn" bindtap="submitRescue">
        <text class="btn-icon">🐱</text>
        <text class="btn-text">立即发布</text>
      </button>
      <text class="submit-tip">发布前请确保信息真实有效</text>
    </view>

    <!-- 底部留白 -->
    <view class="bottom-space"></view>
  </scroll-view>

  <!-- 猫咪装饰动画 -->
  <view class="floating-cats">
    <text class="floating-cat cat-1">😺</text>
    <text class="floating-cat cat-2">😸</text>
    <text class="floating-cat cat-3">😻</text>
  </view>

  <loading show="{{loading}}" text="发布中..." />
</view>

<!-- 自定义TabBar -->
<custom-tabbar currentPath="pages/core/publish/publish" />
