.container {
  background: #f5f5f5;
}

/* 相册头部 */
.album-header {
  background: linear-gradient(135deg, #9C27B0 0%, #7B1FA2 100%);
  padding: 30rpx;
  color: #fff;
}

.header-info {
  margin-bottom: 20rpx;
}

.cat-name {
  display: block;
  font-size: 24rpx;
  opacity: 0.8;
  margin-bottom: 8rpx;
}

.album-title {
  font-size: 40rpx;
  font-weight: bold;
}

.header-stats {
  display: flex;
  gap: 30rpx;
}

.stat-item {
  font-size: 24rpx;
  opacity: 0.9;
}

/* 分类标签 */
.category-tabs {
  display: flex;
  background: #fff;
  padding: 16rpx 24rpx;
  gap: 12rpx;
  overflow-x: auto;
  border-bottom: 1rpx solid #eee;
}

.category-tab {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}

.category-tab.active {
  background: #9C27B0;
}

.tab-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.tab-text {
  font-size: 26rpx;
  color: #666;
}

.category-tab.active .tab-text {
  color: #fff;
}

/* 照片选择区 - 5个格子 */
.photo-slots {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx;
  gap: 16rpx;
  background: #fff;
}

.photo-slot {
  width: calc((100% - 64rpx) / 5);
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f5f5f5;
  border: 2rpx dashed #ddd;
}

.slot-image {
  width: 100%;
  height: 100%;
}

.slot-empty {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.slot-plus {
  font-size: 48rpx;
  color: #ccc;
  font-weight: 300;
}

/* FAB按钮 */
.fab-button {
  position: fixed;
  right: 40rpx;
  bottom: 100rpx;
  width: 100rpx;
  height: 100rpx;
  background: #9C27B0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(156,39,176,0.4);
}

.fab-icon {
  font-size: 48rpx;
  color: #fff;
  font-weight: 300;
}

/* 上传弹窗 */
.upload-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.upload-modal {
  width: 100%;
  background: #fff;
  border-radius: 30rpx 30rpx 0 0;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  padding: 0 10rpx;
}

.modal-body {
  padding: 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

/* 分类选项 */
.category-options {
  display: flex;
  gap: 20rpx;
}

.category-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  border: 2rpx solid #e0e0e0;
  border-radius: 16rpx;
}

.category-option.active {
  border-color: #9C27B0;
  background: #F3E5F5;
}

.option-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.option-text {
  font-size: 24rpx;
  color: #666;
}

.category-option.active .option-text {
  color: #9C27B0;
}

/* 日期选择 */
.date-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
}

.date-text {
  font-size: 28rpx;
  color: #333;
}

.picker-arrow {
  font-size: 32rpx;
  color: #999;
}

/* 备注输入 */
.note-input {
  width: 100%;
  height: 160rpx;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  font-size: 28rpx;
}

/* 照片预览 */
.photo-preview {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 0;
  right: 0;
  width: 48rpx;
  height: 48rpx;
  background: rgba(0,0,0,0.6);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  border-radius: 0 0 0 16rpx;
}

.change-btn {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0,0,0,0.6);
  color: #fff;
  text-align: center;
  font-size: 24rpx;
  padding: 10rpx 0;
}

.choose-photo-btn {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.choose-icon {
  font-size: 60rpx;
  color: #ccc;
}

.choose-text {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

/* 弹窗底部 */
.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.cancel-btn, .confirm-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  border: none;
}

.cancel-btn {
  background: #f5f5f5;
  color: #666;
}

.confirm-btn {
  background: #9C27B0;
  color: #fff;
}

.bottom-space {
  height: 120rpx;
}

/* 待确认照片底部栏 */
.pending-photo-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.1);
  display: flex;
  align-items: center;
  z-index: 100;
}

.pending-content {
  flex: 1;
  display: flex;
  align-items: center;
}

.pending-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.pending-info {
  flex: 1;
}

.pending-title {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 6rpx;
}

.pending-hint {
  display: block;
  font-size: 24rpx;
  color: #9C27B0;
}

.pending-delete {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-icon {
  font-size: 36rpx;
  color: #999;
}
