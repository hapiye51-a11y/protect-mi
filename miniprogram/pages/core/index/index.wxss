/* ========== 咪咪守护站首页 - 清新治愈风格 ========== */

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #E8F5E9 0%, #F5F9F5 15%, #FFFFFF 100%);
  padding-bottom: 0;
}

/* ========== 顶部问候语 ========== */
.header {
  padding: 40rpx 32rpx 32rpx;
}

.greeting {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.greeting-text {
  font-size: 36rpx;
  color: #333;
  font-weight: 400;
}

.greeting-name {
  font-size: 40rpx;
  color: #4CAF50;
  font-weight: 700;
}

.greeting-emoji {
  font-size: 32rpx;
  margin-left: 8rpx;
}

.greeting-sub {
  display: block;
  font-size: 26rpx;
  color: #888;
  margin-top: 8rpx;
}

/* ========== Banner 轮播 ========== */
.banner-section {
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}

.banner-swiper {
  width: 100%;
  height: 440rpx;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(76, 175, 80, 0.2);
}

.banner-bg {
  width: 100%;
  height: 100%;
  position: relative;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(0,0,0,0.5) 100%);
}

.banner-content {
  position: absolute;
  bottom: 32rpx;
  left: 28rpx;
  right: 28rpx;
}

.banner-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.banner-tag {
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.95);
  color: #4CAF50;
  backdrop-filter: blur(8rpx);
}

.banner-tag.urgent {
  background: rgba(244, 67, 54, 0.95);
  color: #FFFFFF;
}

.banner-name {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
}

.banner-info {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.95);
  text-shadow: 0 1rpx 4rpx rgba(0,0,0,0.2);
}

/* Banner 空状态 */
.banner-empty {
  width: 100%;
  height: 320rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #C8E6C9 0%, #A5D6A7 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.empty-emoji {
  font-size: 64rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #4CAF50;
  font-weight: 600;
}

.empty-hint {
  font-size: 24rpx;
  color: #81C784;
}

/* ========== 统计横条 ========== */
.stats-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 24rpx 24rpx;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.1);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #4CAF50;
}

.stat-label {
  font-size: 24rpx;
  color: #888;
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: #E8F5E9;
}

/* ========== 今日待办 ========== */
.todo-section {
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}

.todo-count {
  font-size: 24rpx;
  color: #FF9800;
  font-weight: 600;
}

.todo-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.08);
}

.todo-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #F5F9F5;
}

.todo-item:last-child {
  border-bottom: none;
}

.todo-item:active {
  background: #F5F9F5;
}

.todo-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
}

.todo-icon.feeding {
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
}

.todo-icon.visit {
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%);
}

.todo-icon.adopt {
  background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%);
}

.todo-icon.done {
  background: #F5F5F5;
  opacity: 0.6;
}

.todo-content {
  flex: 1;
}

.todo-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 4rpx;
}

.todo-desc {
  font-size: 24rpx;
  color: #888;
}

.todo-status {
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  background: rgba(76, 175, 80, 0.1);
  color: #4CAF50;
}

.todo-status.done {
  background: rgba(158, 158, 158, 0.1);
  color: #9E9E9E;
}

.todo-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 24rpx;
}

.todo-empty-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.todo-empty-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.todo-empty-hint {
  font-size: 24rpx;
  color: #888;
}

/* ========== 快捷功能入口 ========== */
.quick-actions {
  padding: 0 24rpx;
  margin-bottom: 28rpx;
}

.action-row {
  display: flex;
  gap: 16rpx;
}

.action-card-small {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 20rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.1);
  transition: all 0.3s ease;
}

.action-card-small:active {
  transform: scale(0.96);
  background: #F5F9F5;
}

.action-icon-small {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.action-title-small {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

/* ========== 更多功能 ========== */
.more-section {
  padding: 0 24rpx;
  margin-bottom: 28rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
}

.section-count {
  font-size: 24rpx;
  color: #4CAF50;
  font-weight: 600;
}

.section-more {
  font-size: 26rpx;
  color: #4CAF50;
  font-weight: 500;
}

.more-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.more-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 12rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.08);
  transition: all 0.3s ease;
}

.more-item:active {
  transform: scale(0.95);
  background: #F5F9F5;
}

.more-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  font-size: 36rpx;
}

.more-icon.primary {
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
}

.more-icon.accent {
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%);
}

.more-icon.success {
  background: linear-gradient(135deg, #E0F2F1 0%, #B2DFDB 100%);
}

.more-icon.danger {
  background: linear-gradient(135deg, #FFEBEE 0%, #FFCDD2 100%);
}

.more-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
}

/* ========== 猫咪网格 ========== */
.cats-section {
  padding: 0 24rpx;
  margin-bottom: 28rpx;
}

.cats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.cat-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(76, 175, 80, 0.12);
  transition: all 0.3s ease;
}

.cat-card:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 12rpx rgba(76, 175, 80, 0.1);
}

.cat-image-wrap {
  position: relative;
  width: 100%;
  height: 280rpx;
}

.cat-image {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
}

.cat-urgent {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 6rpx 12rpx;
  background: rgba(244, 67, 54, 0.95);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 12rpx;
}

.cat-info {
  padding: 20rpx;
}

.cat-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cat-meta {
  display: block;
  font-size: 24rpx;
  color: #888;
  margin-bottom: 12rpx;
}

.cat-status-wrap {
  display: inline-block;
}

.cat-status {
  font-size: 22rpx;
  color: #4CAF50;
  font-weight: 500;
  background: rgba(76, 175, 80, 0.1);
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
}

/* 猫咪空状态 */
.cats-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.08);
}

.empty-emoji-big {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #888;
}

/* ========== 底部留白 ========== */
.bottom-space {
  height: 140rpx;
}

/* ========== 响应式适配 ========== */
@media (max-width: 375px) {
  .banner-swiper {
    height: 380rpx;
  }
  
  .cat-image-wrap {
    height: 240rpx;
  }
  
  .section-title {
    font-size: 32rpx;
  }
}
