.loading-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 9999;
}

.loading-content {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 60rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

.paw-container {
  position: relative;
  width: 120rpx;
  height: 80rpx;
  margin-bottom: 32rpx;
}

.paw {
  position: absolute;
  font-size: 48rpx;
  animation: pawBounce 1.2s ease-in-out infinite;
}

.paw-1 {
  left: 0;
  animation-delay: 0s;
}

.paw-2 {
  left: 36rpx;
  animation-delay: 0.2s;
}

.paw-3 {
  left: 72rpx;
  animation-delay: 0.4s;
}

@keyframes pawBounce {
  0%, 60%, 100% {
    transform: translateY(0) scale(1);
    opacity: 0.6;
  }
  30% {
    transform: translateY(-20rpx) scale(1.2);
    opacity: 1;
  }
}

.loading-text {
  font-size: 28rpx;
  color: #666666;
  text-align: center;
}
